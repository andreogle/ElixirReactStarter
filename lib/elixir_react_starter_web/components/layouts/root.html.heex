<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.inertia_title>{assigns[:page_title] || "ElixirReactStarter"}</.inertia_title>
    <.inertia_head content={@inertia_head} />
    <%!-- Theme bootstrap. Reads the `theme` cookie before any CSS/JS
         loads and applies the `dark` class to <html> so the first
         paint matches the user's choice — no flash of light when
         they prefer dark. Mirrors `assets/js/theme.ts`. --%>
    <script>
      (function() {
        var m = document.cookie.match(/(?:^|;\s*)theme=(light|dark|system)/);
        var t = (m && m[1]) || 'system';
        var dark = t === 'dark' || (t === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
        if (dark) document.documentElement.classList.add('dark');
      })();
    </script>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script type="module" defer phx-track-static src={~p"/assets/app.js"} />
  </head>
  <body>
    {@inner_content}
  </body>
</html>
