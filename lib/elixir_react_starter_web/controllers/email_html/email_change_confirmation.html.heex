<.email_layout>
  <tr>
    <td style="padding: 48px 40px;">
      <h2 style="margin: 0 0 16px; font-size: 24px; font-weight: 600; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
        {@heading}
      </h2>

      <p style="margin: 0 0 24px; font-size: 16px; line-height: 1.6; color: #666666; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
        {@greeting}
      </p>

      <p style="margin: 0 0 32px;">
        <a
          href={@url}
          style="display: inline-block; padding: 12px 24px; background-color: #1a1a1a; color: #ffffff; text-decoration: none; border-radius: 6px; font-size: 14px; font-weight: 500; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;"
        >
          {@button_label}
        </a>
      </p>

      <p style="margin: 0 0 16px; font-size: 13px; line-height: 1.6; color: #999999; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
        {@paste_url_label}<br />
        <a href={@url} style="color: #666666; word-break: break-all;">{@url}</a>
      </p>

      <p style="margin: 0 0 16px; font-size: 14px; line-height: 1.6; color: #666666; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
        {@expiry}
      </p>

      <p style="margin: 0; font-size: 14px; line-height: 1.6; color: #999999; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
        {@ignore}
      </p>
    </td>
  </tr>
</.email_layout>
