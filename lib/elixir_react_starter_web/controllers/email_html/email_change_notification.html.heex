<.email_layout>
  <tr>
    <td style="padding: 48px 40px;">
      <h2 style="margin: 0 0 16px; font-size: 24px; font-weight: 600; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
        {@heading}
      </h2>

      <p style="margin: 0 0 24px; font-size: 16px; line-height: 1.6; color: #666666; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
        {@greeting}
      </p>

      <p style="margin: 0; font-size: 14px; line-height: 1.6; color: #999999; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
        {@action}
      </p>
    </td>
  </tr>
</.email_layout>
