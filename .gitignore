# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
elixir_react_starter-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/
/priv/ssr.js

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# Pre-compressed siblings written by assets.deploy (brotli) and phx.digest
# (gzip). Build artifacts, never checked in.
*.br
*.gz

# phx.digest writes content-hashed copies next to every tracked file in
# priv/static/ (favicon, logo, robots.txt, etc). Always regenerable.
/priv/static/favicon-*.ico
/priv/static/robots-*.txt
/priv/static/images/logo-*.svg

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

# Playwright E2E (assets/e2e) artefacts
/assets/playwright-report/
/assets/test-results/
/assets/blob-report/
/assets/playwright/.cache/

# TypeScript incremental build info (e.g. from `tsc -p tsconfig.e2e.json`)
*.tsbuildinfo

# Auto-generated SSR pages registry
/assets/js/_ssr_pages.ts

# LSP
.elixir_ls
.expert

# Dialyzer PLTs (regenerated; CI restores from cache)
/priv/plts/

# macOS Finder metadata
.DS_Store

