{
  "type": "module",
  "engines": {
    "npm": ">=11.10.0"
  },
  "scripts": {
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:install": "playwright install chromium",
    "e2e:ui": "playwright test --ui",
    "fmt": "npm run lint:fix",
    "lint": "biome check --error-on-warnings",
    "lint:fix": "biome check --write",
    "test:unit": "node --test 'js/**/*.test.ts' 'build/*.test.cjs'",
    "typecheck": "node build/generate-ssr-pages.cjs && tsc -p tsconfig.json && tsc -p tsconfig.e2e.json"
  },
  "dependencies": {
    "@inertiajs/core": "^3.11.0",
    "@inertiajs/react": "^3.11.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sentry/node": "^11.11.0",
    "@sentry/react": "^11.10.0",
    "@types/phoenix": "^1.6.8",
    "i18next": "^27.0.1",
    "lucide-react": "^1.66.0",
    "phoenix": "^1.8.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "@sentry/cli": "^3.8.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "typescript": "^7.0.2"
  }
}
