{
  "type": "module",
  "engines": {
    "npm": ">=11.10.0"
  },
  "scripts": {
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:install": "playwright install chromium",
    "e2e:ui": "playwright test --ui",
    "fmt": "npm run lint:fix",
    "lint": "biome check --error-on-warnings",
