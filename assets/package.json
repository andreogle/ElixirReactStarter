    "@sentry/cli": "^3.7.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.13.0",
    "typescript": "^7.0.2"
  }
