{
  "type": "module",
  "engines": {
    "npm": ">=11.10.0"
  },
  "scripts": {
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:install": "playwright install chromium",
    "e2e:ui": "playwright test --ui",
    "fmt": "npm run lint:fix && biome format --write",
    "lint": "biome check build/ css/ e2e/ js/",
    "lint:fix": "biome check --write build/ css/ e2e/ js/",
    "test:unit": "node --test 'js/**/*.test.ts'",
    "typecheck": "node build/generate-ssr-pages.cjs && tsc -p tsconfig.json && tsc -p tsconfig.e2e.json"
  },
  "dependencies": {
    "@inertiajs/react": "^3.6.1",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/node": "^10.69.0",
    "@sentry/react": "^10.69.0",
    "@types/phoenix": "^1.6.7",
    "i18next": "^26.3.6",
    "lucide-react": "^1.28.0",
    "phoenix": "^1.8.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@playwright/test": "^1.62.1",
    "@sentry/cli": "^3.6.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "axe-core": "^4.12.1",
    "typescript": "^7.0.2"
  }
}
