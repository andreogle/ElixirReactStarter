# Supply-chain guard: don't install any package version that was
# published in the last 3 days. New publishes are the highest-risk
# window for compromised tarballs (malicious updates are usually
# pulled within hours-to-days of release); waiting 3 days lets the
# ecosystem catch most of them before they reach our lockfile.
#
# Requires npm >= 11.10.0. Older npm silently ignores unknown
# config, so the `engines` field in package.json fails loudly when
# someone tries to install on an out-of-date npm.
min-release-age=3
